{
  "name": "detour",
  "version": "0.5.1",
  "private": true,
  "description": "See when a YouTube video is also on Nebula or Floatplane, and open it there, automatically if you subscribe.",
  "license": "MIT",
  "scripts": {
    "test": "node test/background.test.js && node test/build-known.test.js",
    "test:e2e": "node test/e2e.js",
    "lint": "web-ext lint --self-hosted --ignore-files 'test/**' 'scripts/**' 'dist/**' 'store/**' 'data/**' 'assets/**' '_layouts/**' 'index.html' '_config.yml' 'package*.json' 'node_modules/**'",
    "build": "bash scripts/build.sh",
    "build:list": "node scripts/build-known.js"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "web-ext": "10.8.0"
  }
}
